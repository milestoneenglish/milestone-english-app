# Salin file ini menjadi .env.local lalu isi nilainya dari
# Supabase Dashboard > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rahasia. Hanya dipakai skrip di laptop (npm run setup:owner) dan server.
# Jangan pernah dibagikan atau dimasukkan ke kode.
SUPABASE_SERVICE_ROLE_KEY=

# Untuk npm run db:migrate. Rahasia (berisi password database).
SUPABASE_DB_URL=

# Alamat aplikasi, dipakai untuk link di email dan WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifikasi. Selama kosong, pesan hanya dicatat (status "Belum dikirim") dan tidak dikirim.
# Email lewat Resend: API key dan alamat pengirim dari domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=
EMAIL_FROM=Milestone English <halo@domainanda.com>
# WhatsApp lewat Fonnte (pilot). Rahasia.
WHATSAPP_PROVIDER=fonnte
FONNTE_TOKEN=

# Pengaman jadwal harian (pengingat tugas H-1). Isi string acak panjang di Vercel; Vercel Cron mengirimnya otomatis.
CRON_SECRET=
