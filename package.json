{
  "name": "milestone-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "setup:owner": "node --env-file=.env.local scripts/setup-owner.mjs",
    "check": "tsc --noEmit && eslint && vitest run",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "e2e:fase1": "node --env-file=.env.local tests/e2e/fase1.mjs",
    "e2e:fase2": "node --env-file=.env.local tests/e2e/fase2.mjs",
    "e2e:fase3": "node --env-file=.env.local tests/e2e/fase3.mjs",
    "setup:role": "node --env-file=.env.local scripts/setup-role.mjs",
    "report:sample": "esbuild scripts/sample-report.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --log-level=warning --outfile=e2e-output/sample-report.mjs && node e2e-output/sample-report.mjs",
    "e2e:fase4": "node --env-file=.env.local tests/e2e/fase4.mjs",
    "e2e:fase5": "node --env-file=.env.local tests/e2e/fase5.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
